# Emberwood: static hosting settings for Apache / LiteSpeed.

# Always https: the game server only takes the game from https://emberwood…, and the app (offline
# play, installing it) needs it too.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# Never serve git metadata (the site is deployed with `git pull` into the web root) or logs.
RedirectMatch 404 /\.git
RedirectMatch 404 \.log$
# The game server (server/) runs as its own Node.js app; its files aren't part of the website.
RedirectMatch 404 ^/server/

<IfModule mod_mime.c>
  AddType text/javascript .js
  AddType model/gltf-binary .glb
  AddType model/gltf+json .gltf
  AddType application/octet-stream .bin
  AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_headers.c>
  # Code changes on every deploy: make browsers re-check it so players get updates.
  <FilesMatch "\.(html|js|css|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Models and textures rarely change.
  <FilesMatch "\.(glb|gltf|bin|png)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript model/gltf+json model/gltf-binary application/octet-stream application/manifest+json
</IfModule>
